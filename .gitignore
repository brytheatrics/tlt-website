# Big asset folders at the REPO ROOT only (synced via Drive, not git).
# Leading slash anchors the pattern so it doesn't match e.g. wordpress/themes/tlt/assets/
/scrape/
/assets/
/mockup/

# Separate project (Google Apps Script: Ludus sync / casting / bios).
# Lives here on disk but is NOT part of the website repo; has its own git repo.
# Critically, contains a Google service-account key that must never be committed.
/tlt-manager/

# Local server inventory snapshot — too big for git, regenerated as needed
tlt_server_inventory.json

# Triage app's intermediate output
triage/candidates.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local test artifacts
*.log

# DB dumps for deploy — contain content, large; canonical DB lives on Cloudways
/deploy/dumps/

# Cloudways connection details (real one is per-machine; commit only the example)
/deploy/cloudways.json

# Recovered third-party reviews — copyright belongs to the publications, kept
# as an internal archive only. NEVER commit (would publish them publicly).
/archive/reviews/

# GAS Callboard reference files pulled from Drive as porting reference.
# ContractGenerator.js contains the OpenSign API key hardcoded — do NOT
# commit. If you need this snapshot, re-copy from
# G:\My Drive\WebApp Production\Callboard Crossover\
/deploy/callboard-gas-reference/
